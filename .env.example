# Copy this file to ".env" (same folder) and fill in real values. ".env" itself is denied by
# .htaccess and must never be committed/shared — it holds real database credentials.

# "mysql" for production (shared hosting). "sqlite" is a local-dev convenience that needs no
# MySQL server at all — see api/lib/db.php.
DB_DRIVER=mysql

DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=

# Only used when DB_DRIVER=sqlite. Defaults to data/aufstellung.sqlite if unset.
# DB_SQLITE_PATH=

# Maximum size (bytes) accepted for a single share-link payload (project JSON + logo + song
# combined). Media larger than the reverse proxy's own request-body cap still gets here fine — the
# client splits it into chunks first (js/share.js, api/share/media_chunk.php) — so this is purely
# this app's own ceiling, not a proxy workaround. Default: 100 MB.
SHARE_MAX_BYTES=104857600

# Password for /admin (manage the global Figuren-Katalog and Vorlagen catalog). Required — /admin
# refuses to log in at all until this is set. Pick a real password, not the placeholder below.
ADMIN_PASSWORD=
